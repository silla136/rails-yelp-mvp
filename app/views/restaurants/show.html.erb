<div class="card w-75 m-3 text-center p-0">
  <div class="card-body">
    <h1 class="card-title"><%= @restaurant.name %></h1>
    <p class="card-text"><strong>Address: </strong><%= @restaurant.address %></p>
    <p class="card-text"><strong>Phone number: </strong><%= @restaurant.phone_number %></p>
    <p class="card-text"><strong>Category: </strong><%= @restaurant.category %></p>
  </div>

    <div class="card-header border-top">
      <h4 class="my-0">Reviews</h4>
    </div>

    <ul class="list-group list-group-flush">
      <% @restaurant.reviews.each do |review| %>
        <li class="list-group-item fw-lighter">Rating: <%= review.rating %>, <i>"<%= review.content %>"</i></li>
      <% end %>
    </ul>

    <div class="card-footer p-3">
        <%= link_to "Add a Review", new_restaurant_review_path(@restaurant), class: "btn btn-success d-inline" %>
    </div>

</div>
